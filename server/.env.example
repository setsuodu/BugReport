# Copy to .env and edit. docker compose auto-loads .env in the same directory.
#   cp .env.example .env

# --- Auth (client Ingest Key must match INGEST) ---
AUTH_INGEST_API_KEY=dev-ingest-key
AUTH_ADMIN_API_KEY=dev-admin-key

# --- Postgres ---
POSTGRES_USER=bugreport
POSTGRES_PASSWORD=bugreport
POSTGRES_DB=bugreport

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=bugreport-attachments
